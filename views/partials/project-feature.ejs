<% const left = index % 2 === 0; %>
<article class="proj grid md:grid-cols-12 gap-8 md:gap-12 items-center mb-24 md:mb-32">
  <div class="md:col-span-7 <%= left ? '' : 'md:order-2' %> relative">
    <figure class="overflow-hidden border-2 border-ink bg-paper">
      <div class="art aspect-[4/3] flex items-center justify-center">
        <img src="<%= project.image %>" alt="<%= project.title %>" class="w-full h-full object-cover" loading="lazy">
      </div>
    </figure>
    <p class="absolute -top-6 <%= left ? '-right-2 sm:-right-6 rotate-[4deg]' : '-left-2 sm:-left-6 rotate-[-4deg]' %> bg-orange text-paper font-mono text-xs px-4 py-2 shadow-[3px_3px_0_#191714]">FN-0<%= index + 1 %></p>
  </div>
  <div class="md:col-span-5 <%= left ? '' : 'md:order-1' %>">
    <p class="font-mono text-[11px] tracking-[.25em] text-soft uppercase mb-3"><%= project.meta %></p>
    <h3 class="ptitle font-display font-light text-4xl sm:text-5xl leading-none"><%= project.title %></h3>
    <p class="mt-5 text-[15px] leading-[1.8] text-ink/75"><%= project.description %></p>
    <ul class="mt-5 flex flex-wrap gap-2 text-xs font-mono text-soft">
      <% project.tags.forEach(tag => { %>
        <li class="border border-ink/25 px-2.5 py-1"><%= tag %></li>
      <% }) %>
    </ul>
    <p class="mt-7 text-sm font-mono"><a href="<%= project.href %>" target="_blank" rel="noopener" class="u-hover text-blued"><%= project.linkText %> <span class="go inline-block">→</span></a></p>
  </div>
</article>
