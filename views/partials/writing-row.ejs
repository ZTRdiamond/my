<% const d = post.createdAt; const fmtDate = [String(d.getDate()).padStart(2,'0'), String(d.getMonth()+1).padStart(2,'0')].join('.') + '.' + String(d.getFullYear()).slice(2); %>
<li class="wrow border-t border-ink/15" data-title="<%= post.title.toLowerCase() %>" data-tags="<%= post.tags.join(',').toLowerCase() %>" data-date="<%= post.createdAt.getTime() %>">
  <a href="/blog/<%= post.slug %>" class="group grid md:grid-cols-12 gap-3 md:gap-6 items-baseline py-7 md:py-9">
    <span class="wnum md:col-span-1 font-mono text-sm text-soft"><%= fmtDate %></span>
    <span class="md:col-span-7">
      <span class="wtitle block font-display font-light text-xl sm:text-3xl leading-tight"><%= post.title %></span>
      <span class="mt-2 block text-sm text-soft leading-relaxed"><%= post.description %></span>
    </span>
    <span class="md:col-span-4 md:text-right flex md:justify-end flex-wrap gap-2 text-[11px] font-mono uppercase tracking-wider text-soft">
      <span class="border border-ink/20 px-2 py-0.5"><%= post.readingTime.replace(' min read', ' menit') %></span>
      <% post.tags.slice(0, 2).forEach(tag => { %>
        <span class="border border-ink/20 px-2 py-0.5">#<%= tag.toLowerCase() %></span>
      <% }) %>
      <span class="warr text-blue">→</span>
    </span>
  </a>
</li>
