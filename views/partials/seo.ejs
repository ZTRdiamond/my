<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= seo.title %></title>
<meta name="description" content="<%= seo.description %>">
<link rel="canonical" href="<%= seo.canonical %>">

<!-- Open Graph -->
<meta property="og:type" content="<%= seo.ogType || 'website' %>">
<meta property="og:title" content="<%= seo.ogTitle || seo.title %>">
<meta property="og:description" content="<%= seo.ogDescription || seo.description %>">
<meta property="og:image" content="<%= seo.ogImage %>">
<meta property="og:image:alt" content="<%= seo.ogImageAlt || seo.ogTitle || seo.title %>">
<meta property="og:url" content="<%= seo.canonical %>">
<meta property="og:site_name" content="<%= config.siteName || 'Portfolio' %>">
<meta property="og:locale" content="id_ID">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= seo.ogTitle || seo.title %>">
<meta name="twitter:description" content="<%= seo.ogDescription || seo.description %>">
<meta name="twitter:image" content="<%= seo.ogImage %>">
<meta name="twitter:image:alt" content="<%= seo.ogImageAlt || seo.ogTitle || seo.title %>">

<!-- ================================================================= -->
<!-- ARTICLE METADATA (blog posts)                                      -->
<!-- Only rendered when ogType === 'article'                           -->
<!-- ================================================================= -->
<% if (seo.ogType === 'article') { %>
  <% if (seo.publishedTime) { %><meta property="article:published_time" content="<%= seo.publishedTime %>"><% } %>
  <% if (seo.modifiedTime) { %><meta property="article:modified_time" content="<%= seo.modifiedTime %>"><% } %>
  <% if (seo.author) { %><meta property="article:author" content="<%= seo.author %>"><% } %>
  <% if (seo.tags && seo.tags.length) { %><% seo.tags.forEach(tag => { %><meta property="article:tag" content="<%= tag %>"><% }) %><% } %>
<% } %>

<!-- ================================================================= -->
<!-- PORTFOLIO METADATA                                                 -->
<!-- Only rendered when page === 'portfolio'                           -->
<!-- ================================================================= -->
<% if (page === 'portfolio' && profile) { %>
  <meta name="author" content="<%= profile.name %>">
  <meta name="robots" content="index, follow">
  <meta name="googlebot" content="index, follow">
  <meta name="theme-color" content="#2A4BEA">
  <meta property="profile:first_name" content="<%= profile.name.split(' ')[0] %>">
  <meta property="profile:last_name" content="<%= profile.name.split(' ').slice(1).join(' ') %>">
  <% if (profile.github) { %>
    <link rel="me" href="<%= profile.github %>">
  <% } %>
  <% if (profile.email) { %>
    <link rel="me" href="mailto:<%= profile.email %>">
  <% } %>
<% } %>
