<!-- ============ NAVIGASI UTAMA ============ -->
<header class="fixed top-0 inset-x-0 z-50 bg-paper/85 backdrop-blur-sm border-b border-ink/10">
  <nav class="max-w-6xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between" aria-label="Navigasi utama">
    <a href="/" class="nav-ink font-display text-2xl tracking-tight flex items-baseline gap-1 group">
      F<span class="text-blue italic inline-block transition-transform duration-300 group-hover:rotate-12">·</span>AM
    </a>

    <!-- Link halaman route yang tersedia -->
    <div class="hidden sm:flex items-center gap-8 font-mono text-[11px] tracking-[.25em] uppercase text-soft">
      <a href="/blog" class="nav-ink u-hover">blog</a>
      <a href="/docs" class="nav-ink u-hover">docs</a>
    </div>

    <button id="menu-toggle" class="nav-ink flex items-center gap-3 font-mono text-[11px] sm:text-xs tracking-[.3em] uppercase py-3 pr-1 pl-3 -mr-2 sm:mr-0" aria-expanded="false" aria-controls="menu-overlay">
      <span class="relative flex flex-col justify-center gap-[6px] w-5 h-5" aria-hidden="true">
        <span class="menu-line block h-[2px] bg-ink w-full"></span>
        <span class="menu-line block h-[2px] bg-ink w-full"></span>
      </span>
      <span class="menu-label">Menu</span>
    </button>
  </nav>
</header>

<!-- ============ MENU OVERLAY ============ -->
<div id="menu-overlay" class="fixed inset-0 z-40 bg-ink text-paper overflow-y-auto" aria-hidden="true" inert>
  <div class="dots-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-display font-light text-[clamp(6rem,18vw,14rem)] leading-none select-none pointer-events-none" style="color:transparent;-webkit-text-stroke:1px rgba(247,242,232,.10)" aria-hidden="true">menu</span>

  <nav class="relative min-h-full flex flex-col justify-center px-5 sm:px-8 py-24" aria-label="Menu">
    <div class="max-w-6xl mx-auto w-full">
      <p class="font-mono text-[11px] tracking-[.3em] uppercase text-paper/50 mb-12">Navigasi Utama — 04 Bagian · Silakan Ditelusuri</p>

      <ol class="border-t-2 border-paper/25">
        <li class="menu-row border-b border-paper/15">
          <a href="/#notes" class="mlink flex items-baseline gap-4 sm:gap-8 py-5 sm:py-7">
            <span class="menu-row-inner mnum font-mono text-sm text-paper/50" style="--d:80ms">01</span>
            <span class="menu-row-inner mtitle font-display font-light text-[clamp(2.2rem,7.5vw,5.6rem)] leading-none">Work</span>
            <span class="menu-row-inner mhand font-hand text-xl sm:text-2xl text-orange hidden md:inline -rotate-2">proyek &amp; karya terorganisir</span>
            <span class="menu-row-inner marr text-orange ml-auto" aria-hidden="true">↗</span>
          </a>
        </li>
        <li class="menu-row border-b border-paper/15">
          <a href="/#writing" class="mlink flex items-baseline gap-4 sm:gap-8 py-5 sm:py-7">
            <span class="menu-row-inner mnum font-mono text-sm text-paper/50" style="--d:160ms">02</span>
            <span class="menu-row-inner mtitle font-display font-light text-[clamp(2.2rem,7.5vw,5.6rem)] leading-none">Writing</span>
            <span class="menu-row-inner mhand font-hand text-xl sm:text-2xl text-orange hidden md:inline rotate-1">catatan, artikel &amp; refleksi</span>
            <span class="menu-row-inner marr text-orange ml-auto" aria-hidden="true">↗</span>
          </a>
        </li>
        <li class="menu-row border-b border-paper/15">
          <a href="/#now" class="mlink flex items-baseline gap-4 sm:gap-8 py-5 sm:py-7">
            <span class="menu-row-inner mnum font-mono text-sm text-paper/50" style="--d:240ms">03</span>
            <span class="menu-row-inner mtitle font-display font-light text-[clamp(2.2rem,7.5vw,5.6rem)] leading-none">Now</span>
            <span class="menu-row-inner mhand font-hand text-xl sm:text-2xl text-orange hidden md:inline rotate-2">fokus &amp; aktivitas saat ini</span>
            <span class="menu-row-inner marr text-orange ml-auto" aria-hidden="true">↗</span>
          </a>
        </li>
        <li class="menu-row">
          <a href="/#contact" class="mlink flex items-baseline gap-4 sm:gap-8 py-5 sm:py-7">
            <span class="menu-row-inner mnum font-mono text-sm text-paper/50" style="--d:320ms">04</span>
            <span class="menu-row-inner mtitle font-display font-light text-[clamp(2.2rem,7.5vw,5.6rem)] leading-none">Contact</span>
            <span class="menu-row-inner mhand font-hand text-xl sm:text-2xl text-orange hidden md:inline -rotate-1">mari berdiskusi</span>
            <span class="menu-row-inner marr text-orange ml-auto" aria-hidden="true">↗</span>
          </a>
        </li>
      </ol>

      <div class="mt-12 flex flex-wrap items-center justify-between gap-6">
        <div class="flex flex-wrap gap-x-8 gap-y-2 font-mono text-xs text-paper/60">
          <% socials.forEach(social => { %>
            <a href="<%= social.url %>" target="_blank" rel="noopener" class="transition-colors duration-300 hover:text-paper"><%= social.name.toLowerCase() %> ↗</a>
          <% }) %>
          <a href="/blog" class="transition-colors duration-300 hover:text-paper">arsip tulisan ↗</a>
        </div>
        <p id="jkt" class="font-mono text-xs text-paper/40"></p>
      </div>
    </div>
  </nav>

  <span class="absolute bottom-6 right-6 text-orange text-2xl spin-slow hidden sm:block" aria-hidden="true">✦</span>
</div>
