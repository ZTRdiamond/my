<!-- ============================================================
     PORTFOLIO PAGE — CV / BIODATA DIGITAL (PRO IMPROVED EDITION)
     Tech Stack: EJS + Tailwind CSS + Vanilla JS
     ============================================================ -->

<!-- ============================================================
     00. HERO & PROFILE BENTO GRID SECTION
     Function: Menampilkan identitas utama, status ketersediaan,
               serta navigasi tindakan cepat (Email Copy, PDF Download)
     ============================================================ -->
<section id="pf-hero" class="min-h-screen flex flex-col justify-center px-4 sm:px-8 pt-28 pb-16 relative overflow-hidden bg-paper text-ink transition-colors duration-300">
  <!-- Dynamic Background Grid Decorative Dots -->
  <div class="dots absolute inset-0 opacity-40 -z-10 pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto w-full">
    <!-- Header Subtitle / Kategori -->
    <div class="reveal flex items-center justify-between gap-4 mb-8">
      <p class="font-mono text-[11px] sm:text-xs tracking-[.3em] uppercase text-soft flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-blue animate-ping"></span>
        <span class="text-blue font-bold">portfolio</span> — curriculum vitæ digital
      </p>
      <span class="font-mono text-[11px] text-soft hidden sm:block">Update Terakhir: <%= new Date().getFullYear() %></span>
    </div>

    <!-- Main Bento Grid Wrapper -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Left Bento Card: Avatar, Status Badge, Quick Actions -->
      <div class="reveal lg:col-span-4 bg-paper2/60 backdrop-blur-md border border-ink/10 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all duration-300">
        <div class="flex flex-col items-center text-center sm:text-left sm:flex-row lg:flex-col lg:items-center">
          <!-- Frame Avatar dengan Interactive Glow -->
          <div class="relative w-36 h-36 sm:w-40 sm:h-40 rounded-2xl overflow-hidden border-2 border-ink/20 shadow-lg group shrink-0">
            <img src="<%= profile.avatar %>" alt="Foto <%= profile.name %>"
                 class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500 ease-out"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
            <div class="hidden w-full h-full bg-paper2 items-center justify-center">
              <span class="font-display text-5xl text-ink/30"><%= profile.name.charAt(0) %></span>
            </div>
          </div>

          <!-- Detail Status Ketersediaan Kolaborasi -->
          <div class="mt-4 sm:mt-0 sm:ml-6 lg:ml-0 lg:mt-5 text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-ink/10 bg-paper/80 font-mono text-[11px] text-soft shadow-xs">
              <span class="w-2.5 h-2.5 rounded-full <%= profile.status === 'available' ? 'bg-emerald-500 animate-pulse' : 'bg-amber-500' %>"></span>
              <span class="font-medium text-ink"><%= profile.status === 'available' ? 'Tersedia untuk Kolaborasi' : 'Sedang Bekerja' %></span>
            </div>
            <p class="font-mono text-[11px] text-soft mt-2">Aktif sejak <%= profile.joined %></p>
          </div>
        </div>

        <!-- Tombol Aksi Cepat Cetak & Unduh -->
        <div class="mt-6 pt-6 border-t border-ink/10 flex flex-col gap-2.5">
          <a href="/portfolio/cv.pdf" download
             class="w-full font-mono text-xs border border-ink bg-ink text-paper px-4 py-3 rounded-xl hover:bg-ink/80 transition-all duration-200 flex items-center justify-center gap-2 shadow-sm active:scale-[0.98] no-underline text-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Unduh CV PDF
          </a>
          <a href="#experience" class="w-full font-mono text-xs border border-ink/20 bg-paper/50 text-ink px-4 py-3 rounded-xl hover:border-ink transition-all duration-200 flex items-center justify-center gap-2">
            Lihat Riwayat →
          </a>
        </div>
      </div>

      <!-- Right Bento Card: Header Utama, Summary, Meta Information -->
      <div class="reveal lg:col-span-8 bg-paper2/60 backdrop-blur-md border border-ink/10 rounded-2xl p-6 sm:p-8 shadow-sm flex flex-col justify-between">
        <div>
          <!-- Nama Profil -->
          <h1 class="font-display font-light leading-[1.05] tracking-tight text-3xl sm:text-5xl lg:text-6xl text-ink">
            <%= profile.name %>
          </h1>
          <p class="font-mono text-sm sm:text-base mt-3 text-blued font-medium tracking-wide">
            <%= profile.title %>
          </p>

          <!-- Rangkuman Ringkas Bio -->
          <p class="mt-5 text-[15px] sm:text-base leading-relaxed text-ink/80 max-w-2xl">
            <%- profile.summary.replace(/\s+/g, ' ').trim().replace(/\n/g, ' ') %>
          </p>

          <!-- Kutipan Tagline Profil -->
          <div class="mt-6 inline-flex items-center gap-3 bg-blue/10 border border-blue/20 px-4 py-2.5 rounded-xl">
            <span class="font-hand text-2xl text-blue leading-none">“</span>
            <span class="font-display italic text-ink/90 text-sm"><%= profile.tagline %></span>
            <span class="font-hand text-2xl text-blue leading-none">”</span>
          </div>
        </div>

        <!-- Meta Contact Grid & Interactive Copy Button -->
        <div class="mt-8 pt-6 border-t border-ink/10 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 font-mono text-xs">
          <div class="flex items-center gap-2.5 text-soft bg-paper/60 p-2.5 rounded-lg border border-ink/5">
            <span class="text-blue">⌖</span>
            <span class="truncate text-ink"><%= profile.location %></span>
          </div>
          
          <div class="flex items-center justify-between gap-2 text-soft bg-paper/60 p-2.5 rounded-lg border border-ink/5 group">
            <div class="flex items-center gap-2 min-w-0">
              <span class="text-blue">@</span>
              <a href="mailto:<%= profile.email %>" class="truncate text-ink hover:text-blue transition-colors"><%= profile.email %></a>
            </div>
            <!-- Interactive Copy Email Function -->
            <button onclick="copyEmail('<%= profile.email %>')" aria-label="Copy email address" title="Copy Email" class="text-soft hover:text-ink p-1 rounded transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </button>
          </div>

          <div class="flex items-center gap-2.5 text-soft bg-paper/60 p-2.5 rounded-lg border border-ink/5">
            <span class="text-blue">⌥</span>
            <a href="<%= profile.website %>" target="_blank" rel="noopener" class="truncate text-ink hover:text-blue transition-colors">Situs Utama ↗</a>
          </div>

          <div class="flex items-center gap-2.5 text-soft bg-paper/60 p-2.5 rounded-lg border border-ink/5">
            <svg class="w-3.5 h-3.5 text-blue" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.78 0 12.5c0 5.42 3.44 10 8.2 11.6.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.54-1.38-1.33-1.75-1.33-1.75-1.09-.74.08-.73.08-.73 1.2.09 1.83 1.23 1.83 1.23 1.07 1.83 2.8 1.3 3.48.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.56 22.5 24 17.92 24 12.5 24 5.78 18.63.5 12 .5z"/></svg>
            <a href="<%= profile.github %>" target="_blank" rel="noopener" class="truncate text-ink hover:text-blue transition-colors">GitHub ↗</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
     MARQUEE SEPARATOR
     Function: Running text visual separator untuk impresi profesional
     ============================================================ -->
<div class="bg-ink text-paper overflow-hidden py-3 shadow-inner" aria-hidden="true">
  <div class="marquee-track font-mono text-xs tracking-[.3em] uppercase opacity-90 select-none">
    <span class="flex items-center gap-8 pr-8 font-semibold">cv ✦ portfolio ✦ <%= profile.name %> ✦ <%= profile.title %> ✦</span>
    <span class="flex items-center gap-8 pr-8 font-semibold">cv ✦ portfolio ✦ <%= profile.name %> ✦ <%= profile.title %> ✦</span>
  </div>
</div>

<!-- ============================================================
     01. PENGALAMAN KERJA TIMELINE
     Function: Menampilkan riwayat karier berbasis interaktif timeline
     ============================================================ -->
<section id="experience" class="px-4 sm:px-8 py-20 md:py-28" aria-label="Pengalaman Kerja">
  <div class="max-w-6xl mx-auto">
    <!-- Section Title Block -->
    <div class="relative mb-14">
      <span class="absolute -top-12 -right-2 font-display font-light text-[clamp(4.5rem,12vw,10rem)] leading-none text-blue/10 select-none pointer-events-none" aria-hidden="true">01</span>
      <div class="flex items-baseline justify-between gap-4 relative">
        <h2 class="font-mono text-xs tracking-[.3em] uppercase text-soft font-semibold">01 — Pengalaman Kerja</h2>
        <span class="font-hand text-xl text-orange -rotate-1 hidden sm:inline">karier &amp; rekam jejak</span>
      </div>
    </div>

    <!-- Timeline Wrapper -->
    <div class="relative">
      <div class="absolute left-[15px] sm:left-[19px] top-3 bottom-3 w-0.5 bg-ink/15" aria-hidden="true"></div>

      <ol class="space-y-10">
        <% experience.forEach((exp, i) => { %>
          <li class="reveal relative pl-10 sm:pl-14">
            <!-- Timeline Node Point -->
            <div class="absolute left-0 top-1.5 w-8 h-8 rounded-full bg-paper border-2 border-ink flex items-center justify-center shadow-sm">
              <div class="w-3 h-3 rounded-full <%= exp.current ? 'bg-blue animate-pulse' : 'bg-ink/40' %>"></div>
            </div>

            <!-- Experience Content Card -->
            <div class="bg-paper border border-ink/10 hover:border-blue/30 rounded-2xl p-6 shadow-xs hover:shadow-md transition-all duration-300">
              <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                <div>
                  <h3 class="font-display font-medium text-xl sm:text-2xl text-ink leading-snug"><%= exp.role %></h3>
                  <p class="font-mono text-sm text-blued mt-0.5 font-semibold"><%= exp.company %></p>
                </div>
                <div class="text-right font-mono text-xs text-soft space-y-1 shrink-0">
                  <div class="bg-paper2 px-3 py-1 rounded-full border border-ink/5">
                    <%= exp.start %> <span class="text-ink/40">—</span> <%= exp.current ? 'Sekarang' : exp.end %>
                  </div>
                  <div class="text-[11px]"><%= exp.location %></div>
                </div>
              </div>

              <!-- Badge Tipe Pekerjaan -->
              <span class="inline-block font-mono text-[10px] tracking-widest uppercase border px-2.5 py-1 rounded-md mb-4 font-semibold
                <%= exp.type === 'full-time' ? 'border-blue/30 bg-blue/5 text-blued' :
                   exp.type === 'freelance' ? 'border-orange/30 bg-orange/5 text-orange' :
                   'border-ink/20 bg-paper2 text-soft' %>">
                <%= exp.type %>
              </span>

              <!-- Highlight Points -->
              <ul class="space-y-2.5">
                <% exp.highlights.forEach(h => { %>
                  <li class="flex items-start gap-3 text-sm leading-relaxed text-ink/80">
                    <span class="text-blue mt-1 shrink-0 font-bold">▸</span>
                    <span><%= h %></span>
                  </li>
                <% }) %>
              </ul>
            </div>
          </li>
        <% }) %>
      </ol>
    </div>
  </div>
</section>

<!-- ============================================================
     02. PENDIDIKAN & RANGKUMAN STATISTIK
     Function: Menampilkan riwayat akademik dan counter ringkas
     ============================================================ -->
<section id="education" class="px-4 sm:px-8 py-20 md:py-28 bg-paper2/50 border-y border-ink/5" aria-label="Pendidikan">
  <div class="max-w-6xl mx-auto">
    <div class="relative mb-14">
      <span class="absolute -top-12 -right-2 font-display font-light text-[clamp(4.5rem,12vw,10rem)] leading-none text-blue/10 select-none pointer-events-none" aria-hidden="true">02</span>
      <div class="flex items-baseline justify-between gap-4 relative">
        <h2 class="font-mono text-xs tracking-[.3em] uppercase text-soft font-semibold">02 — Pendidikan</h2>
        <span class="font-hand text-xl text-orange -rotate-1 hidden sm:inline">latar belakang akademis</span>
      </div>
    </div>

    <div class="grid md:grid-cols-12 gap-8 items-stretch">
      <!-- Main Education Items -->
      <div class="md:col-span-8 space-y-6">
        <% education.forEach((edu, i) => { %>
          <div class="reveal bg-paper border-l-4 border-blue border-y border-r border-ink/10 p-6 sm:p-8 rounded-r-2xl shadow-xs">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
              <div>
                <h3 class="font-display font-medium text-2xl text-ink"><%= edu.degree %></h3>
                <p class="font-mono text-sm text-blued font-semibold mt-1"><%= edu.school %></p>
              </div>
              <div class="font-mono text-xs text-soft text-right bg-paper2 px-3 py-1 rounded-lg">
                <div><%= edu.start %> — <%= edu.end %></div>
                <div class="mt-0.5 text-[11px]"><%= edu.location %></div>
              </div>
            </div>
            <p class="text-sm text-ink/80 leading-relaxed mb-4"><%= edu.note %></p>
            <% if (edu.activities && edu.activities.length) { %>
              <div class="pt-4 border-t border-ink/10 space-y-2">
                <p class="font-mono text-[10px] tracking-widest uppercase text-soft font-semibold">Aktivitas &amp; Organisasi</p>
                <ul class="grid sm:grid-cols-2 gap-2">
                  <% edu.activities.forEach(a => { %>
                    <li class="flex items-start gap-2 text-xs text-ink/75 bg-paper2/60 p-2 rounded-lg">
                      <span class="text-blue mt-0.5 font-bold">✦</span>
                      <span><%= a %></span>
                    </li>
                  <% }) %>
                </ul>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>

      <!-- Key Stats Summary Bento Card -->
      <div class="reveal md:col-span-4 grid grid-cols-1 gap-4">
        <div class="bg-paper border border-blue/20 rounded-2xl p-6 text-center flex flex-col items-center justify-center shadow-xs">
          <p class="font-display font-light text-5xl text-blue"><%= profile.joined %></p>
          <p class="font-mono text-xs uppercase tracking-widest text-soft mt-2 font-semibold">Tahun Memulai Karier</p>
        </div>
        <div class="bg-paper border border-ink/10 rounded-2xl p-6 text-center flex flex-col items-center justify-center shadow-xs">
          <p class="font-display font-light text-5xl text-ink"><%= experience.length %></p>
          <p class="font-mono text-xs uppercase tracking-widest text-soft mt-2 font-semibold">Peran Profesional</p>
        </div>
        <div class="bg-paper border border-ink/10 rounded-2xl p-6 text-center flex flex-col items-center justify-center shadow-xs">
          <p class="font-display font-light text-5xl text-orange"><%= certifications.length %></p>
          <p class="font-mono text-xs uppercase tracking-widest text-soft mt-2 font-semibold">Sertifikasi Resmi</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
     03. KEMAMPUAN TEKNIS (SKILLS)
     Function: Skill bar dengan visual progress bar & animasi
     ============================================================ -->
<section id="skills" class="px-4 sm:px-8 py-20 md:py-28" aria-label="Kemampuan">
  <div class="max-w-6xl mx-auto">
    <div class="relative mb-14">
      <span class="absolute -top-12 -right-2 font-display font-light text-[clamp(4.5rem,12vw,10rem)] leading-none text-blue/10 select-none pointer-events-none" aria-hidden="true">03</span>
      <div class="flex items-baseline justify-between gap-4 relative">
        <h2 class="font-mono text-xs tracking-[.3em] uppercase text-soft font-semibold">03 — Kemampuan Teknis</h2>
        <span class="font-hand text-xl text-orange -rotate-1 hidden sm:inline">keahlian &amp; tools</span>
      </div>
    </div>

    <!-- Interactive Skill Cards Grid -->
    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
      <% skills.forEach((group, gi) => { %>
        <div class="reveal border border-ink/10 rounded-2xl p-6 bg-paper hover:border-blue/30 shadow-xs hover:shadow-md transition-all duration-300">
          <div class="flex items-center gap-3 mb-6 pb-3 border-b border-ink/10">
            <div class="w-8 h-8 rounded-xl bg-blue/10 flex items-center justify-center">
              <div class="w-2.5 h-2.5 rounded-full bg-blue"></div>
            </div>
            <h3 class="font-mono text-xs uppercase tracking-[.2em] text-soft font-bold"><%= group.category %></h3>
          </div>

          <ul class="space-y-4">
            <% group.items.forEach(skill => { %>
              <li>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-sm font-medium text-ink"><%= skill.name %></span>
                  <span class="font-mono text-xs text-soft font-semibold"><%= skill.level %>%</span>
                </div>
                <!-- Animated Progress Track -->
                <div class="h-2 bg-ink/10 rounded-full overflow-hidden p-0.5">
                  <div class="h-full bg-blue rounded-full transition-all duration-1000 ease-out"
                       style="width: 0"
                       data-width="<%= skill.level %>">
                  </div>
                </div>
                <% if (skill.note) { %>
                  <p class="font-mono text-[10px] text-soft mt-1"><%= skill.note %></p>
                <% } %>
              </li>
            <% }) %>
          </ul>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ============================================================
     04. KEMAMPUAN BAHASA
     Function: Menampilkan bahasa yang dikuasai beserta levelnya
     ============================================================ -->
<section id="languages" class="px-4 sm:px-8 py-20 md:py-28 bg-paper2/50 border-y border-ink/5" aria-label="Kemampuan Bahasa">
  <div class="max-w-6xl mx-auto">
    <div class="relative mb-14">
      <span class="absolute -top-12 -right-2 font-display font-light text-[clamp(4.5rem,12vw,10rem)] leading-none text-blue/10 select-none pointer-events-none" aria-hidden="true">04</span>
      <div class="flex items-baseline justify-between gap-4 relative">
        <h2 class="font-mono text-xs tracking-[.3em] uppercase text-soft font-semibold">04 — Kemampuan Bahasa</h2>
        <span class="font-hand text-xl text-orange -rotate-1 hidden sm:inline">komunikasi lingua</span>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-6 max-w-4xl">
      <% languages.forEach((lang, li) => { %>
        <div class="reveal flex items-center gap-5 border border-ink/10 rounded-2xl p-6 bg-paper hover:border-blue/30 shadow-xs transition-all duration-300">
          <div class="text-4xl leading-none shrink-0 p-3 bg-paper2 rounded-xl border border-ink/5"><%= lang.flag %></div>

          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2">
              <h3 class="font-display text-xl font-medium text-ink"><%= lang.name %></h3>
              <% if (lang.native) { %>
                <span class="font-mono text-[9px] tracking-widest uppercase bg-blue/10 text-blued px-2 py-0.5 rounded-full font-bold">Native</span>
              <% } %>
            </div>

            <div class="h-2 bg-ink/10 rounded-full overflow-hidden p-0.5 mb-2">
              <div class="h-full bg-blue rounded-full transition-all duration-1000 ease-out"
                   style="width: 0"
                   data-width="<%= lang.level %>">
              </div>
            </div>
            <p class="font-mono text-xs text-soft font-medium"><%= lang.label %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<% if (certifications && certifications.length) { %>
<!-- ============================================================
     05. SERTIFIKASI KERJA
     Function: Kartu kredensial profesional & link sertifikat
     ============================================================ -->
<section id="certifications" class="px-4 sm:px-8 py-20 md:py-28" aria-label="Sertifikasi">
  <div class="max-w-6xl mx-auto">
    <div class="relative mb-14">
      <span class="absolute -top-12 -right-2 font-display font-light text-[clamp(4.5rem,12vw,10rem)] leading-none text-blue/10 select-none pointer-events-none" aria-hidden="true">05</span>
      <div class="flex items-baseline justify-between gap-4 relative">
        <h2 class="font-mono text-xs tracking-[.3em] uppercase text-soft font-semibold">05 — Sertifikasi</h2>
        <span class="font-hand text-xl text-orange -rotate-1 hidden sm:inline">kredensial resmi</span>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% certifications.forEach((cert, ci) => { %>
        <div class="reveal border border-ink/10 rounded-2xl p-6 bg-paper hover:border-blue/30 hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-blue/10 flex items-center justify-center text-blue">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <span class="font-mono text-xs text-soft font-semibold bg-paper2 px-2.5 py-1 rounded-full"><%= cert.year %></span>
            </div>
            <h3 class="font-display font-medium text-lg leading-snug text-ink mb-1"><%= cert.name %></h3>
            <p class="font-mono text-xs text-blued font-semibold mb-3"><%= cert.issuer %></p>
            <% if (cert.note) { %><p class="text-xs text-ink/75 leading-relaxed"><%= cert.note %></p><% } %>
          </div>
          <% if (cert.url) { %>
            <a href="<%= cert.url %>" target="_blank" rel="noopener" class="mt-6 pt-4 border-t border-ink/10 inline-flex items-center gap-1.5 font-mono text-xs text-blued font-semibold hover:text-blue transition-colors">
              Verifikasi Sertifikat ↗
            </a>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ============================================================
     CTA & FOOTER CONTACT SECTION
     Function: Penutup halaman & sarana kontak langsung
     ============================================================ -->
<section id="pf-contact" class="px-4 sm:px-8 py-24 md:py-32 relative overflow-hidden bg-paper" aria-label="Hubungi">
