<div class="px-5 sm:px-8 pt-32 md:pt-40 pb-28 md:pb-40">
  <div class="max-w-6xl mx-auto">

    <!-- Back link -->
    <div>
      <a href="/docs" class="inline-flex items-center gap-2 font-mono text-xs tracking-[.25em] uppercase text-soft u-hover">← kembali ke dokumentasi</a>
    </div>

    <div class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

      <!-- Primary Content -->
      <article class="lg:col-span-8 space-y-8">
        <header class="border-b-2 border-ink pb-8 space-y-4">
          <div class="font-mono text-[11px] tracking-[.25em] uppercase text-soft">Dokumentasi Teknis</div>
          <h1 class="font-display font-light leading-[1.05] tracking-tight text-[clamp(2rem,5vw,3.6rem)]">
            <%= doc.title %>
          </h1>
          <% if (doc.description) { %>
            <p class="text-[15px] text-soft leading-relaxed max-w-xl">
              <%= doc.description %>
            </p>
          <% } %>
        </header>

        <div class="prose prose-slate max-w-none leading-relaxed">
          <%- doc.html %>
        </div>
      </article>

      <!-- Sidebar: Index Dokumen -->
      <aside class="hidden lg:block lg:col-span-3 lg:col-start-10 sticky top-24">
        <div class="border-2 border-ink bg-paper p-6 space-y-4">
          <div class="flex items-center gap-2 font-mono text-[11px] tracking-[.25em] uppercase text-soft">
            <span class="w-2 h-2 bg-blue inline-block"></span>
            <span>Indeks Dokumen</span>
          </div>
          <ol class="space-y-1">
            <% docs.forEach(d => { %>
              <li>
                <a href="/docs/<%= d.slug %>" class="block font-mono text-xs py-1.5 transition-colors duration-200 <%= d.slug === doc.slug ? 'text-blue border-l-2 border-blue pl-3' : 'text-soft hover:text-blued pl-3 border-l-2 border-ink/15' %>">
                  <%= d.title %>
                </a>
              </li>
            <% }) %>
          </ol>
        </div>
      </aside>

    </div>
  </div>
</div>
