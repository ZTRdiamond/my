<div class="px-5 sm:px-8 pt-32 md:pt-40 pb-28 md:pb-40">
  <div class="max-w-6xl mx-auto">

    <!-- Page Header -->
    <div class="relative">
      <span class="absolute -top-24 -right-4 font-display font-light text-[clamp(6rem,18vw,15rem)] leading-none text-blue/10 select-none pointer-events-none" aria-hidden="true">04</span>
      <div class="flex items-baseline justify-between mb-6 relative">
        <h2 class="font-mono text-xs tracking-[.3em] uppercase text-soft">04 — Publikasi &amp; Tulisan</h2>
        <span class="font-hand text-2xl text-orange rotate-2 hidden sm:inline">arsip lengkap</span>
      </div>
      <h1 class="font-display font-light leading-[.96] tracking-tight text-[clamp(2.4rem,7vw,5.5rem)]">Arsip <em class="italic text-blue">Tulisan.</em></h1>
      <p class="mt-6 max-w-2xl text-[15px] leading-[1.85] text-ink/80">
        Catatan pemikiran, dokumentasi pembacaan, dan rekam jejak proses belajar. Telusuri berdasarkan kata kunci atau topik.
      </p>
    </div>

    <!-- Search & Sort -->
    <div class="mt-14 flex flex-col sm:flex-row items-stretch gap-3">
      <div class="relative flex-grow">
        <input type="text" id="searchInput" placeholder="cari judul, tag, atau topik…" class="w-full pl-5 pr-4 py-3 bg-paper border-2 border-ink text-ink placeholder:text-soft/70 font-mono text-sm focus:outline-none focus:border-blue transition-colors duration-200">
      </div>
      <div class="sm:w-56 shrink-0 relative">
        <select id="sortSelect" class="w-full pl-4 pr-10 py-3 bg-paper border-2 border-ink text-ink font-mono text-sm focus:outline-none focus:border-blue transition-colors duration-200 appearance-none cursor-pointer">
          <option value="newest">Terbaru dulu</option>
          <option value="oldest">Terlama dulu</option>
        </select>
        <span class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-soft">▾</span>
      </div>
    </div>

    <!-- Filter Tag Chips -->
    <div id="tagFilterBar" class="mt-6 flex flex-wrap items-center gap-2">
      <button type="button" class="tag-btn text-xs font-mono px-4 py-2 border border-blue bg-tint text-blued cursor-pointer transition-all duration-200" data-tag="" aria-pressed="true">Semua Topik</button>
      <% tags.forEach((tag, index) => { %>
        <button type="button"
                class="tag-btn text-xs font-mono px-4 py-2 border border-ink/25 bg-paper text-soft hover:border-blue hover:text-blued cursor-pointer transition-all duration-200 <%= index >= 5 ? 'hidden extra-tag' : '' %>"
                data-tag="<%= tag %>"
                aria-pressed="false">
          #<%= tag %>
        </button>
      <% }) %>
      <% if (tags.length > 5) { %>
        <button type="button" id="toggleTagsBtn" class="text-xs font-mono px-4 py-2 bg-ink text-paper hover:bg-blue cursor-pointer transition-colors duration-200 flex items-center gap-1.5">
          <span id="toggleText">Lainnya</span><span id="toggleIcon">+</span>
        </button>
      <% } %>
    </div>

    <!-- Article Rows -->
    <ol id="postsGrid" class="mt-10 border-b-4 border-ink">
      <% posts.forEach(post => { %>
        <%- include('../partials/writing-row', { post }) %>
      <% }) %>
    </ol>

    <!-- Pagination -->
    <div id="paginationContainer" class="flex items-center justify-center gap-1.5 pt-12 pb-4"></div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden text-center py-20">
      <p class="font-hand text-3xl text-soft rotate-[-1deg]">tidak ada tulisan yang cocok — coba kata kunci lain.</p>
    </div>
  </div>
</div>

<!-- Scripts -->
<script>
  (function () {
    const itemsPerPage = 2;
    let currentPage = 1;
    let activeTag = '';
    let tagsExpanded = false;

    const searchInput = document.getElementById('searchInput');
    const sortSelect = document.getElementById('sortSelect');
    const postsGrid = document.getElementById('postsGrid');
    const emptyState = document.getElementById('emptyState');
    const tagFilterBar = document.getElementById('tagFilterBar');
    const toggleTagsBtn = document.getElementById('toggleTagsBtn');
    const paginationContainer = document.getElementById('paginationContainer');
    const postCards = Array.from(postsGrid.children).filter(el => el.tagName === 'LI');

    function getCardAttr(card, attrName) {
      return card ? (card.getAttribute(attrName) || '') : '';
    }

    function toggleExtraTags() {
      tagsExpanded = !tagsExpanded;
      document.querySelectorAll('.extra-tag').forEach(tag => tag.classList.toggle('hidden', !tagsExpanded));
      const t = document.getElementById('toggleText');
      const i = document.getElementById('toggleIcon');
      if (t) t.textContent = tagsExpanded ? 'Lebih sedikit' : 'Lainnya';
      if (i) i.textContent = tagsExpanded ? '−' : '+';
    }

    function setTagButtonStates() {
      tagFilterBar.querySelectorAll('.tag-btn').forEach(btn => {
        const isSelected = (btn.getAttribute('data-tag') || '').toLowerCase() === (activeTag || '').toLowerCase();
        btn.classList.toggle('border-blue', isSelected);
        btn.classList.toggle('bg-tint', isSelected);
        btn.classList.toggle('text-blued', isSelected);
        btn.classList.toggle('border-ink/25', !isSelected);
        btn.classList.toggle('bg-paper', !isSelected);
        btn.classList.toggle('text-soft', !isSelected);
        btn.setAttribute('aria-pressed', String(isSelected));
      });
    }

    function filterAndRender() {
      const query = searchInput.value.toLowerCase().trim();

      const matchedCards = postCards.filter(card => {
        const title = getCardAttr(card, 'data-title');
        const tagsString = getCardAttr(card, 'data-tags');
        const tags = tagsString.split(',').map(t => t.trim());

        const matchesSearch = title.includes(query) || tags.some(tag => tag.includes(query));
        const matchesTag = activeTag === '' || tags.includes(activeTag.toLowerCase());

        return matchesSearch && matchesTag;
      });

      const direction = sortSelect.value;
      matchedCards.sort((a, b) => {
        const dateA = parseInt(getCardAttr(a, 'data-date') || '0');
        const dateB = parseInt(getCardAttr(b, 'data-date') || '0');
        return direction === 'newest' ? dateB - dateA : dateA - dateB;
      });

      const totalItems = matchedCards.length;
      const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      postCards.forEach(card => card.style.display = 'none');
      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      matchedCards.slice(startIndex, endIndex).forEach(card => card.style.display = '');

      emptyState.classList.toggle('hidden', totalItems !== 0);
      renderPagination(totalPages);
    }

    function renderPagination(totalPages) {
      if (totalPages <= 1) { paginationContainer.innerHTML = ''; return; }

      let html = '';
      const prevDisabled = currentPage === 1;
      html += `<button type="button" data-page="${currentPage - 1}" ${prevDisabled ? 'disabled' : ''} class="w-9 h-9 border-2 border-ink bg-paper text-ink hover:bg-ink hover:text-paper cursor-pointer transition-colors duration-200 disabled:opacity-30 disabled:pointer-events-none" aria-label="Halaman sebelumnya">‹</button>`;

      const delta = 1;
      const pages = [];
      for (let i = 1; i <= totalPages; i++) {
        if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) {
          pages.push(i);
        } else if (pages[pages.length - 1] !== '…') {
          pages.push('…');
        }
      }

      pages.forEach(p => {
        if (p === '…') {
          html += `<span class="inline-flex items-center justify-center w-9 h-9 text-soft font-mono text-xs">•••</span>`;
        } else {
          const isActive = p === currentPage;
          html += `<button type="button" data-page="${p}" class="w-9 h-9 font-mono text-sm cursor-pointer transition-colors duration-200 ${isActive ? 'bg-blue text-paper' : 'border-2 border-ink bg-paper text-ink hover:bg-ink hover:text-paper'}">${p}</button>`;
        }
      });

      const nextDisabled = currentPage === totalPages;
      html += `<button type="button" data-page="${currentPage + 1}" ${nextDisabled ? 'disabled' : ''} class="w-9 h-9 border-2 border-ink bg-paper text-ink hover:bg-ink hover:text-paper cursor-pointer transition-colors duration-200 disabled:opacity-30 disabled:pointer-events-none" aria-label="Halaman berikutnya">›</button>`;

      paginationContainer.innerHTML = html;
    }

    function changePage(page) {
      const totalPages = Math.ceil(postCards.filter(card => {
        const query = searchInput.value.toLowerCase().trim();
        const title = getCardAttr(card, 'data-title');
        const tags = getCardAttr(card, 'data-tags').split(',').map(t => t.trim());
        const matchesSearch = title.includes(query) || tags.some(tag => tag.includes(query));
        const matchesTag = activeTag === '' || tags.includes(activeTag.toLowerCase());
        return matchesSearch && matchesTag;
      }).length / itemsPerPage) || 1;
      if (page < 1 || page > totalPages) return;
      currentPage = page;
      filterAndRender();
      searchInput.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function filterTag(tag) {
      activeTag = tag || '';
      currentPage = 1;
      setTagButtonStates();
      filterAndRender();
    }

    // Wire-up: event listener (bukan inline onclick — lebih andal)
    tagFilterBar.addEventListener('click', (e) => {
      const btn = e.target.closest('.tag-btn');
      if (btn) filterTag(btn.getAttribute('data-tag'));
    });

    if (toggleTagsBtn) toggleTagsBtn.addEventListener('click', toggleExtraTags);

    paginationContainer.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-page]');
      if (btn && !btn.disabled) changePage(parseInt(btn.getAttribute('data-page'), 10));
    });

    searchInput.addEventListener('input', () => { currentPage = 1; filterAndRender(); });
    sortSelect.addEventListener('change', () => { currentPage = 1; filterAndRender(); });

    // Init
    setTagButtonStates();
    filterAndRender();
  })();
</script>
