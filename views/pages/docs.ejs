<div class="px-5 sm:px-8 pt-32 md:pt-40 pb-28 md:pb-40">
  <div class="max-w-6xl mx-auto">

    <div class="relative">
      <span class="absolute -top-24 -right-4 font-display font-light text-[clamp(6rem,18vw,15rem)] leading-none text-blue/10 select-none" aria-hidden="true">D</span>
      <div class="flex items-baseline justify-between mb-6 relative">
        <h2 class="font-mono text-xs tracking-[.3em] uppercase text-soft">Dokumentasi</h2>
        <span class="font-hand text-2xl text-orange -rotate-2 hidden sm:inline">catatan teknis</span>
      </div>
      <h1 class="font-display font-light leading-[.96] tracking-tight text-[clamp(2.4rem,7vw,5.5rem)]">Dokumentasi <em class="italic text-blue">Teknis.</em></h1>
      <p class="mt-6 max-w-2xl text-[15px] leading-[1.85] text-ink/80">
        Protokol operasional, arsitektur sistem, dan panduan langkah demi langkah.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-6">
      <% docs.forEach((doc, index) => { %>
        <a href="/docs/<%= doc.slug %>" class="group relative border-2 border-ink bg-paper p-8 hover:bg-tint transition-colors duration-300 flex flex-col justify-between min-h-[220px]">
          <div class="absolute top-0 left-0 bg-ink text-paper font-mono text-xs px-3 py-1.5 group-hover:bg-blue transition-colors duration-300">DOC-0<%= index + 1 %></div>
          <div class="space-y-4 pt-6">
            <h3 class="font-display font-light text-2xl md:text-3xl leading-tight group-hover:text-blue transition-colors duration-300">
              <%= doc.title %>
            </h3>
            <p class="text-sm text-soft leading-relaxed">
              <%= doc.description %>
            </p>
          </div>
          <div class="pt-6 mt-6 border-t border-ink/15">
            <span class="font-mono text-xs text-blued group-hover:translate-x-1 inline-block transition-transform duration-300">baca dokumentasi →</span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</div>
