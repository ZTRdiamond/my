<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CV — <%= profile.name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* ── RESET & A4 EXACT ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    @page {
      size: A4;
      margin: 0 !important;
    }

    @media print {
      html, body {
        width: 210mm !important;
        height: 297mm !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
      }
    }

    html {
      width: 210mm;
      height: 297mm;
      overflow: hidden;
    }

    body {
      width: 210mm;
      height: 297mm;
      overflow: hidden;
      font-family: 'Inter', Arial, sans-serif;
      color: #111;
      background: #fff;
      font-size: 7pt;
      line-height: 1.25;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* ── PAGE: exact A4 minus 6mm LR, 5mm TB ── */
    .page {
      width: 198mm;           /* 210 - 6*2 */
      height: 287mm;          /* 297 - 5*2 */
      padding: 5mm 6mm;
      overflow: hidden;
    }

    /* ── HEADER ── */
    .hdr {
      border-bottom: 1pt solid #000;
      padding-bottom: 3pt;
      margin-bottom: 4pt;
    }
    .hdr-name {
      font-size: 15pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.4pt;
      color: #000;
      line-height: 1.1;
    }
    .hdr-title {
      font-size: 6.5pt;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.25pt;
      color: #555;
      margin-top: 0.5pt;
      margin-bottom: 2.5pt;
    }
    .contact-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0 6pt;
      font-size: 6pt;
      color: #222;
      line-height: 1.35;
    }
    .contact-row a { color: #000; text-decoration: none; }

    /* ── BODY ── */
    .body {
      display: flex;
      gap: 7pt;
    }
    .col-main { flex: 1.7; overflow: hidden; max-height: 258mm; }
    .col-side { flex: 1; overflow: hidden; max-height: 258mm; }

    /* ── SECTIONS ── */
    .section { margin-bottom: 3.5pt; }
    .sec-title {
      font-size: 5pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5pt;
      border-bottom: 0.5pt solid #000;
      padding-bottom: 0.8pt;
      margin-bottom: 2pt;
      color: #000;
    }

    /* ── PROFILE ── */
    .profile { font-size: 6pt; color: #222; line-height: 1.3; }

    /* ── EXPERIENCE ── */
    .item { margin-bottom: 3pt; }
    .item-row { display: flex; justify-content: space-between; align-items: baseline; gap: 2pt; }
    .role { font-size: 7pt; font-weight: 700; color: #000; line-height: 1.1; }
    .date { font-size: 5.5pt; font-weight: 600; color: #555; white-space: nowrap; flex-shrink: 0; }
    .company { font-size: 6pt; font-style: italic; color: #555; margin-bottom: 0.8pt; line-height: 1.25; }
    ul.hl { margin-left: 5pt; }
    ul.hl li { margin-bottom: 0.3pt; font-size: 5.5pt; color: #222; line-height: 1.2; }

    /* ── EDUCATION ── */
    .edu { margin-bottom: 2.5pt; }
    .edu-row { display: flex; justify-content: space-between; align-items: baseline; gap: 2pt; }
    .edu-degree { font-size: 7pt; font-weight: 700; color: #000; line-height: 1.1; }
    .edu-date { font-size: 5.5pt; font-weight: 600; color: #555; white-space: nowrap; flex-shrink: 0; }
    .edu-school { font-size: 6pt; font-style: italic; color: #555; line-height: 1.25; }
    .edu-note { font-size: 5.5pt; color: #333; line-height: 1.2; margin-top: 0.3pt; }

    /* ── SIDEBAR ── */
    .s-group { margin-bottom: 3pt; }
    .s-cat { font-size: 5.5pt; font-weight: 700; color: #000; margin-bottom: 0.3pt; line-height: 1.15; }
    .s-desc { font-size: 5.5pt; color: #333; line-height: 1.25; }
    .s-list { list-style: none; padding: 0; }
    .s-list li { margin-bottom: 1.5pt; font-size: 5.5pt; line-height: 1.2; }
    .s-list li strong { display: block; color: #000; font-size: 5.5pt; }
    .s-list li span { color: #555; font-size: 5pt; display: block; }
  </style>
</head>
<body>
<div class="page">

  <!-- HEADER -->
  <header class="hdr">
    <div class="hdr-name"><%= profile.name %></div>
    <div class="hdr-title"><%= profile.title %></div>
    <div class="contact-row">
      <span><%= profile.location %></span>
      <span>•</span>
      <span><a href="mailto:<%= profile.email %>"><%= profile.email %></a></span>
      <% if (profile.phone) { %><span>•</span><span><%= profile.phone %></span><% } %>
      <% if (profile.website) { %><span>•</span><span><a href="<%= profile.website %>"><%= profile.website.replace('https://','').replace('http://','') %></a></span><% } %>
      <span>•</span>
      <span><a href="<%= profile.github %>">github.com/ztrdiamond</a></span>
    </div>
  </header>

  <!-- BODY -->
  <div class="body">

    <!-- MAIN -->
    <main class="col-main">

      <section class="section">
        <div class="sec-title">Profil Ringkas</div>
        <p class="profile"><%- profile.summary.replace(/\n/g, ' ').replace(/\s+/g, ' ').trim() %></p>
      </section>

      <section class="section">
        <div class="sec-title">Pengalaman Kerja</div>
        <% experience.forEach(exp => { %>
          <div class="item">
            <div class="item-row">
              <span class="role"><%= exp.role %></span>
              <span class="date"><%= exp.start %> – <%= exp.current ? 'Sekarang' : exp.end %></span>
            </div>
            <div class="company"><%= exp.company %> — <%= exp.location %></div>
            <ul class="hl">
              <% exp.highlights.slice(0, 2).forEach(h => { %>
                <li><%= h %></li>
              <% }) %>
            </ul>
          </div>
        <% }) %>
      </section>

      <section class="section">
        <div class="sec-title">Pendidikan</div>
        <% education.forEach(edu => { %>
          <div class="edu">
            <div class="edu-row">
              <span class="edu-degree"><%= edu.degree %></span>
              <span class="edu-date"><%= edu.start %> – <%= edu.end %></span>
            </div>
            <div class="edu-school"><%= edu.school %> — <%= edu.location %></div>
            <% if (edu.note) { %><p class="edu-note"><%= edu.note %></p><% } %>
          </div>
        <% }) %>
      </section>

    </main>

    <!-- SIDEBAR -->
    <aside class="col-side">

      <section class="section">
        <div class="sec-title">Keahlian Teknis</div>
        <% skills.forEach(group => { %>
          <div class="s-group">
            <div class="s-cat"><%= group.category %></div>
            <div class="s-desc"><%= group.items.map(s => s.name).join(', ') %></div>
          </div>
        <% }) %>
      </section>

      <section class="section">
        <div class="sec-title">Sertifikasi</div>
        <ul class="s-list">
          <% certifications.forEach(cert => { %>
            <li><strong><%= cert.name %></strong><span><%= cert.issuer %> (<%= cert.year %>)</span></li>
          <% }) %>
        </ul>
      </section>

      <section class="section">
        <div class="sec-title">Bahasa</div>
        <ul class="s-list">
          <% languages.forEach(lang => { %>
            <li><strong><%= lang.name %></strong><span><%= lang.label %></span></li>
          <% }) %>
        </ul>
      </section>

      <section class="section">
        <div class="sec-title">Minat</div>
        <div class="s-desc"><%= interests.map(i => i.label).join(', ') %>.</div>
      </section>

    </aside>
  </div>
</div>

<script>window.addEventListener('load', () => window.print());</script>
</body>
</html>
