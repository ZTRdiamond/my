<div class="px-5 sm:px-8 pt-32 md:pt-40 pb-28 md:pb-40">
  <div class="max-w-3xl mx-auto">

    <!-- Back link -->
    <div>
      <a href="/blog" class="inline-flex items-center gap-2 font-mono text-xs tracking-[.25em] uppercase text-soft u-hover">← kembali ke arsip</a>
    </div>

    <!-- Header Block -->
    <header class="mt-10 space-y-6">
      <div class="flex flex-wrap items-center gap-2.5 font-mono text-[11px] tracking-[.2em] uppercase text-soft">
        <time datetime="<%= post.createdAt.toISOString() %>"><%= post.createdAt.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></time>
        <span>&bull;</span>
        <span><%= post.readingTime.replace(' min read', ' menit baca') %></span>
        <% if (post.written) { %>
          <span>&bull;</span>
          <span>oleh <%= post.written %></span>
        <% } %>
      </div>

      <h1 class="font-display font-light leading-[1.05] tracking-tight text-[clamp(2rem,6vw,4.2rem)]">
        <%= post.title %>
      </h1>

      <% if (post.tags.length > 0) { %>
        <div class="flex flex-wrap gap-2">
          <% post.tags.forEach(tag => { %>
            <span class="text-[11px] font-mono uppercase tracking-wider border border-ink/25 px-2.5 py-1 text-soft">#<%= tag %></span>
          <% }) %>
        </div>
      <% } %>
    </header>

    <!-- Hero Image -->
    <% if (post.cover) { %>
      <div class="mt-10 border-2 border-ink bg-paper overflow-hidden aspect-[21/9]">
        <img src="<%= post.cover %>" alt="<%= post.title %>" class="w-full h-full object-cover" loading="lazy">
      </div>
    <% } %>

    <!-- Content -->
    <div class="mt-12 prose prose-slate max-w-none leading-relaxed">
      <%- post.html %>
    </div>

    <!-- Footer nav -->
    <div class="mt-16 pt-8 border-t-2 border-ink flex items-center justify-between">
      <a href="/blog" class="font-mono text-xs tracking-[.25em] uppercase text-soft u-hover">← arsip</a>
      <a href="/#contact" class="font-mono text-xs tracking-[.25em] uppercase text-soft u-hover">kontak →</a>
    </div>
  </div>
</div>
