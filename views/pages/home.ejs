<!-- ============ HERO SECTION ============ -->
<section class="relative min-h-screen flex flex-col justify-center px-5 sm:px-8 pt-24 pb-14" aria-label="Pembuka">
  <div class="max-w-6xl mx-auto w-full">

    <p class="reveal font-mono text-xs sm:text-sm text-soft">
      <span class="text-blue">indeks</span> — situs pribadi <%= config.fullName %> — pengembang &amp; penggiat teknologi
    </p>

    <h1 class="font-display font-light leading-[.96] tracking-tight text-[clamp(2.7rem,9.5vw,8.5rem)] mt-6">
      <span class="line-mask"><span class="line-inner">Code, curiosity,</span></span>
      <span class="line-mask"><span class="line-inner">and the things</span></span>
      <span class="line-mask"><span class="line-inner"><em class="italic font-normal text-blue">in between.</em></span></span>
    </h1>

    <div class="relative mt-14 max-w-2xl">
      <div class="dots absolute -inset-8 -z-10 hidden md:block" data-drift="-10"></div>
      <p class="text-[15px] sm:text-base leading-[1.85] text-ink/80">
        Saya merancang kode, mengeksplorasi batas teknologi, dan mendokumentasikan proses belajar tersebut secara berkala. Berawal dari rasa penasaran untuk memahami bagaimana sesuatu bekerja, saya mencoba menuangkannya menjadi karya yang fungsional dan berdampak.
      </p>
    </div>

    <div class="mt-14 grid sm:grid-cols-2 md:grid-cols-4 border-t-2 border-ink">
      <div class="py-5 pr-6 border-b sm:border-b-0 sm:border-r border-ink/15">
        <p class="font-mono text-[11px] uppercase tracking-[.25em] text-soft mb-1.5">Saat Ini</p>
        <p class="text-sm">Fokus membaca, membangun proyek, dan merangkum catatannya.</p>
      </div>
      <div class="py-5 pr-6 border-b sm:border-b-0 sm:border-r border-ink/15">
        <p class="font-mono text-[11px] uppercase tracking-[.25em] text-soft mb-1.5">Lokasi</p>
        <p class="text-sm">Jakarta, Indonesia — GMT+7</p>
      </div>
      <div class="py-5 pr-6 border-b sm:border-b-0 sm:border-r border-ink/15">
        <p class="font-mono text-[11px] uppercase tracking-[.25em] text-soft mb-1.5">Bahasa</p>
        <p class="text-sm">Indonesia (Fasih) · Jawa (Menengah) · Inggris (B1)</p>
      </div>
      <div class="py-5">
        <p class="font-mono text-[11px] uppercase tracking-[.25em] text-soft mb-1.5">Status</p>
        <p class="text-sm"><span class="inline-block w-2 h-2 rounded-full bg-blue mr-2"></span>Terbuka untuk kolaborasi &amp; eksperimen baru</p>
      </div>
    </div>

    <p class="mt-16 font-mono text-[11px] sm:text-xs tracking-[.25em] uppercase text-soft flex items-center gap-3">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="float-y" data-drift="8">
        <path d="M8 1v12M3 8l5 5 5-5" stroke="currentColor" stroke-width="1.2"/>
      </svg>
      gulir ke bawah untuk mengeksplorasi
    </p>
  </div>
</section>

<!-- ============ 01 BUILD (APA YANG SAYA BANGUN) ============ -->
<section id="build" class="px-5 sm:px-8 py-28 md:py-40 bg-tint/50" aria-label="I build things">
  <div class="max-w-6xl mx-auto">
    <div class="relative">
      <span class="absolute -top-20 -right-4 font-display font-light text-[clamp(6rem,18vw,15rem)] leading-none text-blue/10 select-none" aria-hidden="true">01</span>
      <div class="flex items-baseline justify-between mb-14 relative">
        <h2 class="font-mono text-xs tracking-[.3em] uppercase text-soft">01 — Eksplorasi &amp; Karya</h2>
        <span class="font-hand text-2xl text-orange rotate-2">fokus pengembangan</span>
      </div>
    </div>

    <blockquote class="reveal font-display font-light text-[clamp(1.8rem,4.6vw,3.9rem)] leading-[1.1] max-w-4xl">
      «"<em class="italic text-blue">Bagaimana kalau...</em>"
      <span class="text-ink/70">lalu</span>
      "<em class="italic text-blue">Ayo buat!</em>"
      <span class="text-ink/70">— Cara saya mengawali hampir setiap proyek.</span>»
    </blockquote>

    <div class="mt-16 grid md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <p class="reveal text-[15px] leading-[1.85] text-ink/80">
          Saya tidak membatasi diri pada satu domain spesifik. Hal yang paling menarik bagi saya berada di titik temu antar-teknologi—ruang di mana ide abstrak dapat diwujudkan menjadi solusi yang konkret.
        </p>
        <p class="reveal mt-6 text-[15px] leading-[1.85] text-ink/80" style="--d:120ms">
          Terkadang hasilnya berupa aplikasi praktis yang langsung bernilai pakai, terkadang sekadar proyek eksperimental.
          <span class="text-blued italic">Bagi saya, keduanya merupakan proses belajar yang berharga.</span>
        </p>
        <p class="mt-8 font-hand text-3xl text-orange -rotate-2 inline-block">kebiasaan bereksperimen yang terus dirawat.</p>
      </div>

      <div class="md:col-span-6 md:col-start-7">
        <ul class="border-t-4 border-ink">
          <li class="reveal flex items-baseline gap-4 py-3 border-b border-ink/15 text-[15px]"><span class="font-mono text-xs text-blue w-6">01</span>Artificial Intelligence &amp; LLMs</li>
          <li class="reveal flex items-baseline gap-4 py-3 border-b border-ink/15 text-[15px]" style="--d:50ms"><span class="font-mono text-xs text-blue w-6">02</span>Pengembangan Aplikasi Web</li>
          <li class="reveal flex items-baseline gap-4 py-3 border-b border-ink/15 text-[15px]" style="--d:100ms"><span class="font-mono text-xs text-blue w-6">03</span>APIs &amp; Developer Tools</li>
          <li class="reveal flex items-baseline gap-4 py-3 border-b border-ink/15 text-[15px]" style="--d:150ms"><span class="font-mono text-xs text-blue w-6">04</span>Sistem Otomatisasi (Automation)</li>
          <li class="reveal flex items-baseline gap-4 py-3 border-b border-ink/15 text-[15px]" style="--d:200ms"><span class="font-mono text-xs text-blue w-6">05</span>Bot &amp; Integrasi Platform</li>
          <li class="reveal flex items-baseline gap-4 py-3 border-b border-ink/15 text-[15px]" style="--d:250ms"><span class="font-mono text-xs text-blue w-6">06</span>Pengolahan Data &amp; Web Scraping</li>
          <li class="reveal flex items-baseline gap-4 py-3 border-b border-ink/15 text-[15px]" style="--d:300ms"><span class="font-mono text-xs text-blue w-6">07</span>Proyek Open Source</li>
          <li class="reveal flex items-baseline gap-4 py-3 border-b border-ink/15 text-[15px]" style="--d:350ms"><span class="font-mono text-xs text-blue w-6">08</span>Infrastruktur Internet</li>
          <li class="reveal flex items-baseline gap-4 py-3 border-b border-ink/15 text-[15px]" style="--d:400ms"><span class="font-mono text-xs text-blue w-6">09</span>Perangkat Lunak Eksperimental</li>
          <li class="reveal flex items-baseline gap-4 py-3 text-[15px]" style="--d:450ms"><span class="font-mono text-xs text-orange w-6">10</span>Ruang interdisipliner tempat <em class="italic text-blued">teknologi saling bertaut</em></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============ 02 WAY (PRINSIP & CARA BERPIKIR) ============ -->
<section id="way" class="px-5 sm:px-8 py-28 md:py-40" aria-label="The way I work">
  <div class="max-w-6xl mx-auto">
    <div class="relative">
      <span class="absolute -top-20 -right-4 font-display font-light text-[clamp(6rem,18vw,15rem)] leading-none text-blue/10 select-none" aria-hidden="true">02</span>
      <div class="flex items-baseline justify-between mb-14 relative">
        <h2 class="font-mono text-xs tracking-[.3em] uppercase text-soft">02 — Pendekatan Kerja</h2>
        <span class="font-hand text-2xl text-orange -rotate-3">prinsip &amp; pola pikir</span>
      </div>
    </div>

    <ol>
      <li class="reveal grid md:grid-cols-12 gap-4 md:gap-8 items-baseline py-8 md:py-10 border-t-4 border-ink">
        <span class="md:col-span-2 font-display italic text-4xl md:text-5xl text-blue">01</span>
        <div class="md:col-span-6">
          <h3 class="font-display font-light text-3xl md:text-4xl leading-tight">Memahami Sistem Secara Mendalam</h3>
          <p class="mt-3 text-[15px] leading-[1.8] text-ink/75">Saya tidak berhenti saat kode sekadar berfungsi (<em>it works</em>). Terdapat tiga hal yang selalu saya evaluasi: Mengapa sistem ini berhasil bekerja? Bagaimana cara mengoptimalkannya? Dan bagaimana perilakunya saat menghadapi kekeliruan?</p>
        </div>
        <p class="md:col-span-3 md:col-start-10 font-hand text-2xl text-soft rotate-2">pemahaman menyeluruh</p>
      </li>
      <li class="reveal grid md:grid-cols-12 gap-4 md:gap-8 items-baseline py-8 md:py-10 border-t border-ink/15" style="--d:100ms">
        <span class="md:col-span-2 font-display italic text-4xl md:text-5xl text-blue">02</span>
        <div class="md:col-span-6">
          <h3 class="font-display font-light text-3xl md:text-4xl leading-tight">Keingintahuan Sebagai Penggerak Utama</h3>
          <p class="mt-3 text-[15px] leading-[1.8] text-ink/75">Rasa penasaran acap kali membawa saya mengeksplorasi aspek di luar batas masalah utama. Banyak ide bernilai justru lahir dari temuan yang tidak diduga sebelumnya.</p>
        </div>
        <p class="md:col-span-3 md:col-start-10 font-hand text-2xl text-soft -rotate-2">eksplorasi tanpa batas</p>
      </li>
      <li class="reveal grid md:grid-cols-12 gap-4 md:gap-8 items-baseline py-8 md:py-10 border-t border-b-4 border-ink" style="--d:200ms">
        <span class="md:col-span-2 font-display italic text-4xl md:text-5xl text-blue">03</span>
        <div class="md:col-span-6">
          <h3 class="font-display font-light text-3xl md:text-4xl leading-tight">Eksperimentasi yang Terarah</h3>
          <p class="mt-3 text-[15px] leading-[1.8] text-ink/75">Uji coba secara langsung sering kali memberikan wawasan berharga. Saya merancang sesuatu yang menarik, lalu membiarkan temuan dari proyek tersebut menentukan langkah iterasi selanjutnya.</p>
        </div>
        <p class="md:col-span-3 md:col-start-10 font-hand text-2xl text-soft rotate-1">iterasi &amp; evaluasi</p>
      </li>
    </ol>

    <div class="mt-20">
      <p class="reveal font-mono text-[11px] uppercase tracking-[.3em] text-soft mb-6">Di Luar Kode — Bidang Minat &amp; Perspektif</p>
      <ol class="border-t-4 border-ink">
        <li class="reveal grid grid-cols-12 gap-3 md:gap-6 items-baseline py-6 border-b border-ink/15 group">
          <span class="col-span-3 md:col-span-2 font-mono text-xs text-blue">INT-01</span>
          <span class="col-span-9 md:col-span-4 font-display text-2xl md:text-3xl leading-tight transition-colors duration-300 group-hover:text-blue">Teknologi</span>
          <span class="col-span-12 md:col-span-6 text-sm text-ink/70 leading-relaxed">Membangun, mengeksplorasi, dan memahami arsitektur digital secara mendasar.</span>
        </li>
        <li class="reveal grid grid-cols-12 gap-3 md:gap-6 items-baseline py-6 border-b border-ink/15 group" style="--d:60ms">
          <span class="col-span-3 md:col-span-2 font-mono text-xs text-blue">INT-02</span>
          <span class="col-span-9 md:col-span-4 font-display text-2xl md:text-3xl leading-tight italic transition-colors duration-300 group-hover:text-blue">Sains</span>
          <span class="col-span-12 md:col-span-6 text-sm text-ink/70 leading-relaxed">Pertanyaan yang lahir saat mengamati fenomena alamiah secara lebih seksama.</span>
        </li>
        <li class="reveal grid grid-cols-12 gap-3 md:gap-6 items-baseline py-6 border-b border-ink/15 group" style="--d:120ms">
          <span class="col-span-3 md:col-span-2 font-mono text-xs text-blue">INT-03</span>
          <span class="col-span-9 md:col-span-4 font-display text-2xl md:text-3xl leading-tight transition-colors duration-300 group-hover:text-blue">Filsafat</span>
          <span class="col-span-12 md:col-span-6 text-sm text-ink/70 leading-relaxed">Menghubungkan berbagai gagasan dan sudut pandang pemikiran yang berbeda.</span>
        </li>
        <li class="reveal grid grid-cols-12 gap-3 md:gap-6 items-baseline py-6 border-b border-ink/15 group" style="--d:180ms">
          <span class="col-span-3 md:col-span-2 font-mono text-xs text-orange">INT-04</span>
          <span class="col-span-9 md:col-span-4 font-display text-2xl md:text-3xl leading-tight transition-colors duration-300 group-hover:text-orange">Budaya Digital</span>
          <span class="col-span-12 md:col-span-6 text-sm text-ink/70 leading-relaxed">Dinamika internet, fenomena meme, dan pola komunikasi masyarakat modern.</span>
        </li>
        <li class="reveal grid grid-cols-12 gap-3 md:gap-6 items-baseline py-6 border-b border-ink/15 group" style="--d:240ms">
          <span class="col-span-3 md:col-span-2 font-mono text-xs text-blue">INT-05</span>
          <span class="col-span-9 md:col-span-4 font-display text-2xl md:text-3xl leading-tight transition-colors duration-300 group-hover:text-blue">Literasi</span>
          <span class="col-span-12 md:col-span-6 text-sm text-ink/70 leading-relaxed">Membaca buku, publikasi, dan esai. Fokus utama berada pada kedalaman substansi bacaan.</span>
        </li>
      </ol>
      <p class="mt-6 font-hand text-2xl text-soft -rotate-1">rasa ingin tahu yang melampaui baris kode.</p>
    </div>

    <div class="mt-20">
      <p class="reveal font-mono text-[11px] uppercase tracking-[.3em] text-soft mb-5">Kegiatan Waktu Luang</p>
      <p class="reveal font-display text-2xl md:text-3xl leading-snug">
        Membaca · Eksplorasi Hal Baru · Menonton · Diskusi · Programming
      </p>
      <p class="mt-3 font-hand text-2xl text-soft rotate-1">tidak semua hal harus berorientasi pada hasil akhir.</p>
    </div>
  </div>
</section>

<!-- ============ MARQUEE BANNER ============ -->
<div class="bg-blue text-paper overflow-hidden py-3" aria-hidden="true">
  <div class="marquee-track font-mono text-sm tracking-[.3em] uppercase">
    <span class="flex items-center gap-10 pr-10">code ✦ curiosity ✦ what if ✦ let's build it ✦ exploring ✦ learning ✦ building ✦</span>
    <span class="flex items-center gap-10 pr-10">code ✦ curiosity ✦ what if ✦ let's build it ✦ exploring ✦ learning ✦ building ✦</span>
  </div>
</div>

<!-- ============ 03 FIELD NOTES (PORTOFOLIO PROYEK) ============ -->
<section id="notes" class="px-5 sm:px-8 py-28 md:py-40" aria-label="Field notes">
  <div class="max-w-6xl mx-auto">
    <div class="relative">
      <span class="absolute -top-20 -right-4 font-display font-light text-[clamp(6rem,18vw,15rem)] leading-none text-blue/10 select-none" aria-hidden="true">03</span>
      <div class="flex flex-wrap items-baseline justify-between gap-4 mb-16 relative">
        <h2 class="font-mono text-xs tracking-[.3em] uppercase text-soft">03 — Catatan Proyek</h2>
        <p class="text-sm text-soft italic font-display">Empat proyek aktif yang terus dikembangkan secara bertahap</p>
      </div>
    </div>

    <% projects.forEach((project, index) => { %>
      <%- include('../partials/project-feature', { project, index }) %>
    <% }) %>

    <p class="mt-16 font-hand text-2xl text-soft text-center rotate-[-1deg]">proyek dan gagasan berikutnya sedang dipersiapkan.</p>
  </div>
</section>

<!-- ============ 04 WRITING (TULISAN & ESSAY) ============ -->
<section id="writing" class="px-5 sm:px-8 py-28 md:py-40 bg-paper2/50" aria-label="Tulisan">
  <div class="max-w-6xl mx-auto">
    <div class="relative">
      <span class="absolute -top-20 -right-4 font-display font-light text-[clamp(6rem,18vw,15rem)] leading-none text-blue/10 select-none" aria-hidden="true">04</span>
      <div class="flex flex-wrap items-baseline justify-between gap-4 mb-6 relative">
        <h2 class="font-mono text-xs tracking-[.3em] uppercase text-soft">04 — Publikasi &amp; Tulisan</h2>
        <p class="text-sm text-soft italic font-display">Catatan pemikiran dan dokumentasi pembacaan</p>
      </div>
    </div>

    <ol class="mt-10">
      <% posts.slice(0, 3).forEach(post => { %>
        <%- include('../partials/writing-row', { post }) %>
      <% }) %>
      <li class="border-b-4 border-ink"></li>
    </ol>

    <div class="mt-10 text-center">
      <a href="/blog" class="inline-block font-mono text-sm u-hover text-blued">lihat semua tulisan →</a>
    </div>

    <blockquote class="reveal mt-14 border-l-2 border-blue pl-6 max-w-2xl">
      <p class="font-display font-light text-xl sm:text-2xl leading-relaxed">
        "Tulisan di situs ini merupakan cara saya mengabadikan gagasan agar tidak hilang dimakan waktu. Bukan gagasan yang dogmatis, melainkan rekam jejak dari hal-hal yang memicu daya pikir saya."
      </p>
      <footer class="mt-3 font-mono text-xs text-soft">— pengantar tulisan</footer>
    </blockquote>
  </div>
</section>

<!-- ============ 05 NOW (AKTIVITAS SEKARANG) ============ -->
<section id="now" class="px-5 sm:px-8 py-28 md:py-40" aria-label="Sekarang">
  <div class="max-w-6xl mx-auto">
    <div class="relative">
      <span class="absolute -top-20 -right-4 font-display font-light text-[clamp(6rem,18vw,15rem)] leading-none text-blue/10 select-none" aria-hidden="true">05</span>
      <div class="flex flex-wrap items-baseline justify-between gap-4 mb-14 relative">
        <h2 class="font-mono text-xs tracking-[.3em] uppercase text-soft">05 — Fokus Saat Ini</h2>
        <span class="font-hand text-2xl text-orange -rotate-2">laporan berkala</span>
      </div>
    </div>

    <div class="grid md:grid-cols-4 gap-px bg-ink/10 border border-ink/10">
      <div class="bg-paper p-8 reveal">
        <p class="font-mono text-[11px] text-blued mb-5">STATUS-01</p>
        <h3 class="font-mono text-xs uppercase tracking-[.25em] text-soft mb-5">Eksplorasi</h3>
        <p class="font-display text-xl leading-snug">Menjelajahi gagasan baru dan sudut teknologi yang belum sempat dipelajari.</p>
      </div>
      <div class="bg-paper p-8 reveal" style="--d:100ms">
        <p class="font-mono text-[11px] text-blued mb-5">STATUS-02</p>
        <h3 class="font-mono text-xs uppercase tracking-[.25em] text-soft mb-5">Pengembangan</h3>
        <p class="font-display text-xl leading-snug">Membangun perangkat lunak yang bermanfaat — tools, bot, dan proyek eksperimental.</p>
      </div>
      <div class="bg-paper p-8 reveal" style="--d:200ms">
        <p class="font-mono text-[11px] text-blued mb-5">STATUS-03</p>
        <h3 class="font-mono text-xs uppercase tracking-[.25em] text-soft mb-5">Pembelajaran</h3>
        <p class="font-display text-xl leading-snug">Memperdalam pemahaman seputar perkakas AI, arsitektur LLM, dan literatur lintas disiplin.</p>
      </div>
      <div class="bg-paper p-8 reveal" style="--d:300ms">
        <p class="font-mono text-[11px] text-orange mb-5">STATUS-04</p>
        <h3 class="font-mono text-xs uppercase tracking-[.25em] text-soft mb-5">Arah Keingintahuan</h3>
        <p class="font-display text-xl leading-snug">Mengikuti rasa penasaran dan membiarkannya membuka peluang karya baru.</p>
      </div>
    </div>

    <div class="mt-12 grid md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-7 reveal">
        <h3 class="font-mono text-xs uppercase tracking-[.25em] text-soft mb-5">Catatan acak dari proses pengembangan</h3>
        <p class="font-display font-light text-[clamp(1.5rem,3.2vw,2.6rem)] leading-[1.15]">
          "Sebagian proyek telah tertata rapi.
          <em class="italic text-blue">Sebagian lainnya dalam proses refaktorisasi.</em>
          Beberapa di antaranya lahir berkat satu pertanyaan sederhana yang jawabannya ternyata memikat."
        </p>
      </div>
      <div class="md:col-span-4 md:col-start-9 reveal" style="--d:150ms">
        <h3 class="font-mono text-xs uppercase tracking-[.25em] text-soft mb-5">Pelajaran dari Setiap Rilis Proyek</h3>
        <ul class="text-sm text-ink/80 space-y-3 font-mono">
          <li class="flex gap-3"><span class="text-blue">✳</span> Buat cadangan (<em>backup</em>) sebelum refaktorisasi—pelajaran berharga dari pengalaman nyata</li>
          <li class="flex gap-3"><span class="text-blue">✳</span> Sistem <em>logging</em> yang akurat jauh lebih bisa diandalkan daripada sekadar asumsi</li>
          <li class="flex gap-3"><span class="text-blue">✳</span> Menentukan penamaan produk atau bot adalah kombinasi antara fungsionalitas dan seni</li>
        </ul>
        <p class="mt-6 font-hand text-2xl text-soft rotate-[-2deg]">terus belajar, terus membangun.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ 06 CONTACT (KONTAK & PENUTUP) ============ -->
<section id="contact" class="px-5 sm:px-8 py-32 md:py-48 relative overflow-hidden bg-tint/60" aria-label="Penutup">
  <div class="dots absolute inset-0 opacity-70" aria-hidden="true"></div>
  <div class="max-w-6xl mx-auto text-center relative">
    <h2 class="font-display font-light leading-[1.02] tracking-tight text-[clamp(2rem,5.8vw,4.8rem)]">
      Mari wujudkan sesuatu yang
      <br><em class="italic text-blue">menarik bersama.</em>
    </h2>

    <p class="mt-8 text-soft text-sm sm:text-base max-w-md mx-auto">
      Situs ini adalah dokumentasi ringkas dari proyek, bacaan, dan ide yang saya kembangkan. Silakan ditelusuri—jika ada hal yang menarik perhatian Anda, mari berdiskusi lebih lanjut.
    </p>

    <p class="mt-6 font-mono text-xs text-soft">sampai bertemu di diskusi selanjutnya →</p>

    <div class="mt-12 flex flex-wrap justify-center gap-4 text-sm font-mono">
      <% socials.forEach(social => { %>
        <a href="<%= social.url %>" target="_blank" rel="noopener" class="border-2 border-ink px-6 py-3 hover:bg-ink hover:text-paper transition-colors duration-300"><%= social.name.toLowerCase() %> ↗</a>
      <% }) %>
    </div>
  </div>
</section>
